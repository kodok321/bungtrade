# ============================================
# BungTrade AI Trading Platform - Environment
# ============================================

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/bungtrade
DATABASE_SYNC_URL=postgresql://postgres:postgres@db:5432/bungtrade

# Redis
REDIS_URL=redis://redis:6379/0

# Security - CHANGE THESE IN PRODUCTION!
SECRET_KEY=your-super-secret-jwt-key-change-me
ENCRYPTION_KEY=your-32-byte-encryption-key-here!
ALGORITHM=HS256

# OpenAI (optional - for advanced AI analysis)
OPENAI_API_KEY=

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Binance
BINANCE_TESTNET=false

# Risk Management Defaults
DEFAULT_RISK_PER_TRADE=2.0
DEFAULT_MAX_DAILY_LOSS=5.0
DEFAULT_MAX_DRAWDOWN=10.0
DEFAULT_MAX_CONCURRENT_TRADES=5

# Frontend
VITE_API_URL=http://localhost:8000
